<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>Edit your post</h1>

    <p>user id <%=post.id%></p>
    <br>
    <p>user name : @<%=post.user%></p>
